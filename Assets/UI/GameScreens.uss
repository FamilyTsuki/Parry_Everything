/* Écrans du jeu. Tailles pensées pour 1920 × 1080 (le PanelSettings met à l'échelle).
   Couleurs : os (texte), bleu d'âme (accent), braise (danger). */

.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(236, 230, 218);
}

/* ---------- Écrans ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.screen--visible {
    opacity: 1;
}

.shade {
    background-color: rgba(6, 5, 10, 0.78);
}

.shade-dark {
    background-color: rgba(3, 2, 5, 0.9);
}

/* Ombre dégradée à gauche du titre (image générée par le script) */
.side-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
}

.column {
    position: absolute;
    left: 150px;
    top: 0;
    bottom: 0;
    width: 820px;
    justify-content: center;
}

.center-column {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.game-title {
    font-size: 88px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 64px;
    padding: 0;
    white-space: normal;
}

.screen-heading {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 40px;
    padding: 0;
}

/* ---------- Éléments de menu ---------- */

.menu {
    align-items: flex-start;
}

.menu-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 3px 0;
    padding: 8px 24px 8px 20px;
    font-size: 36px;
    color: rgba(236, 230, 218, 0.5);
    -unity-text-align: middle-left;
    transition-property: color, border-color, translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.menu-item:hover,
.menu-item:focus {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(236, 230, 218);
    border-left-color: rgb(140, 196, 255);
    translate: 10px 0;
}

.menu-item:active {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(140, 196, 255);
}

.menu-item:disabled {
    color: rgba(236, 230, 218, 0.2);
}

.item-detail {
    font-size: 21px;
    color: rgba(140, 196, 255, 0.75);
    margin: -6px 0 10px 23px;
    padding: 0;
}

.back-item {
    margin-top: 28px;
}

/* ---------- Options ---------- */

.options-list {
    width: 820px;
}

.option-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 2px 0;
    padding: 10px 12px 10px 20px;
    height: 64px;
    color: rgba(236, 230, 218, 0.5);
    transition-property: color, border-color;
    transition-duration: 0.14s;
}

.option-row:hover,
.option-row:focus {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgb(236, 230, 218);
    border-left-color: rgb(140, 196, 255);
}

.option-name {
    font-size: 30px;
    padding: 0;
    color: rgba(236, 230, 218, 0.6);
}

.option-row:focus > .option-name,
.option-row:hover > .option-name {
    color: rgb(236, 230, 218);
}

.option-control {
    flex-direction: row;
    align-items: center;
    width: 380px;
    justify-content: space-between;
}

.option-arrow {
    font-size: 30px;
    width: 40px;
    -unity-text-align: middle-center;
    padding: 0;
    color: rgba(140, 196, 255, 0.35);
}

.option-row:focus .option-arrow,
.option-row:hover .option-arrow {
    color: rgb(140, 196, 255);
}

.option-value {
    flex-grow: 1;
    font-size: 28px;
    -unity-text-align: middle-center;
    padding: 0;
}

.option-bar {
    flex-grow: 1;
    height: 6px;
    margin: 0 12px;
    background-color: rgba(236, 230, 218, 0.12);
}

.option-bar-fill {
    height: 100%;
    background-color: rgba(140, 196, 255, 0.55);
}

.option-row:focus .option-bar-fill {
    background-color: rgb(140, 196, 255);
}

.option-percent {
    width: 76px;
    font-size: 24px;
    -unity-text-align: middle-right;
    padding: 0;
}

/* ---------- Confirmation ---------- */

.dialog {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 820px;
    padding: 48px 56px 36px 56px;
    background-color: rgb(12, 11, 18);
    border-width: 1px;
    border-color: rgba(236, 230, 218, 0.14);
}

.dialog-message {
    font-size: 34px;
    white-space: normal;
    padding: 0;
    margin-bottom: 12px;
}

.dialog-detail {
    font-size: 24px;
    white-space: normal;
    color: rgba(236, 230, 218, 0.6);
    padding: 0;
    margin-bottom: 32px;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-item {
    font-size: 30px;
    margin-left: 24px;
}

/* ---------- Mort, fin ---------- */

.death-word {
    position: absolute;
    left: 0;
    right: 0;
    top: 42%;
    font-size: 104px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(236, 230, 218);
    letter-spacing: 12px;
    padding: 0;
}

.death-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 80px;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgba(236, 230, 218, 0.45);
    padding: 0;
}

.end-title {
    font-size: 96px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    margin-bottom: 48px;
    padding: 0;
}

.end-item {
    -unity-text-align: middle-center;
}

/* ---------- Bas d'écran ---------- */

.controls-hint {
    position: absolute;
    left: 150px;
    right: 150px;
    bottom: 56px;
    font-size: 21px;
    color: rgba(236, 230, 218, 0.42);
    white-space: normal;
    padding: 0;
}

.version {
    position: absolute;
    right: 40px;
    bottom: 24px;
    font-size: 16px;
    color: rgba(236, 230, 218, 0.25);
    padding: 0;
}

.save-indicator {
    position: absolute;
    right: 56px;
    bottom: 48px;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.save-indicator--visible {
    opacity: 1;
}

.save-glyph {
    width: 14px;
    height: 14px;
    rotate: 45deg;
    border-width: 2px;
    border-color: rgb(140, 196, 255);
    margin-right: 14px;
}

.save-label {
    font-size: 20px;
    color: rgba(236, 230, 218, 0.7);
    padding: 0;
}

.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}
